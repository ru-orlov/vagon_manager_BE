        <sql>
        <![CDATA[
        create or replace function public.inventory_group_audit_trigger_fn() returns trigger as $$
        begin
            if tg_op = 'INSERT' then
                insert into inventory_group_audit(
                    inventory_group_uuid, wagon_uuid, name, description, created_at, updated_at, sync_status, username,
                    operation, changed_by, changed_at, old_data, new_data
                ) values (
                    new.uuid, new.wagon_uuid, new.name, new.description, new.created_at, new.updated_at, new.sync_status, new.username,
                    tg_op, current_user, now(), null, row_to_json(new)::jsonb
                );
                return new;
            elsif tg_op = 'UPDATE' then
                insert into inventory_group_audit(
                    inventory_group_uuid, wagon_uuid, name, description, created_at, updated_at, sync_status, username,
                    operation, changed_by, changed_at, old_data, new_data
                ) values (
                    new.uuid, new.wagon_uuid, new.name, new.description, new.created_at, new.updated_at, new.sync_status, new.username,
                    tg_op, current_user, now(), row_to_json(old)::jsonb, row_to_json(new)::jsonb
                );
                return new;
            elsif tg_op = 'DELETE' then
                insert into inventory_group_audit(
                    inventory_group_uuid, wagon_uuid, name, description, created_at, updated_at, sync_status, username,
                    operation, changed_by, changed_at, old_data, new_data
                ) values (
                    old.uuid, old.wagon_uuid, old.name, old.description, old.created_at, old.updated_at, old.sync_status, old.username,
                    tg_op, current_user, now(), row_to_json(old)::jsonb, null
                );
                return old;
            end if;
            return null;
        end;
        $$ language plpgsql;
        drop trigger if exists trg_inventory_group_audit on inventory_group;
        create trigger trg_inventory_group_audit
        after insert or update or delete on inventory_group
        for each row execute function public.inventory_group_audit_trigger_fn();
        ]]>>
        </sql>


