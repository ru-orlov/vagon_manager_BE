        </createTable>

        <createIndex tableName="wagon" indexName="idx_wagon_uuid_unique" unique="true">
            <column name="uuid"/>
        </createIndex>
        <createIndex tableName="wagon" indexName="idx_wagon_number_unique" unique="true">
            <column name="number"/>
        </createIndex>

        <createTable tableName="wagon_audit">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id" type="BIGINT"/>
            <column name="wagon_uuid" type="uuid"/>
            <column name="number" type="VARCHAR(32)"/>
            <column name="action_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="username" type="VARCHAR(32)"/>
            <column name="operation" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="old_data" type="JSONB"/>
            <column name="new_data" type="JSONB"/>
        </createTable>

        <createIndex tableName="wagon_audit" indexName="idx_wagon_audit_wagon_uuid" unique="false">
            <column name="wagon_uuid"/>
        </createIndex>

        <createIndex tableName="wagon_audit" indexName="idx_wagon_audit_wagon_number" unique="false">
            <column name="number"/>
        </createIndex>

        <sql>
            <![CDATA[
            CREATE OR REPLACE FUNCTION public.wagon_audit_trigger_fn() RETURNS trigger AS $$
            BEGIN
                IF TG_OP = 'INSERT' THEN
                    INSERT INTO wagon_audit(
                        wagon_uuid, number, action_at, username, operation, old_data, new_data
                    ) VALUES (
                        NEW.uuid, NEW.number, now(), NEW.username, TG_OP, NULL, row_to_json(NEW)::jsonb
                    );
                    RETURN NEW;
                ELSIF TG_OP = 'UPDATE' THEN
                    INSERT INTO wagon_audit(
                        wagon_uuid, number, action_at, username, operation, changed_by, old_data, new_data
                    ) VALUES (
                        NEW.uuid, NEW.number, now(), NEW.username, TG_OP, row_to_json(OLD)::jsonb, row_to_json(NEW)::jsonb
                    );
                    RETURN NEW;
                ELSIF TG_OP = 'DELETE' THEN
                    INSERT INTO wagon_audit(
                        wagon_uuid, number, action_at, username, operation, changed_by, old_data, new_data
                    ) VALUES (
                        OLD.uuid, OLD.number, now(), OLD.username, TG_OP, current_user, now(), row_to_json(OLD)::jsonb, NULL
                    );
                    RETURN OLD;
                END IF;
                RETURN NULL;
            END;
            $$ LANGUAGE plpgsql;

            DROP TRIGGER IF EXISTS trg_wagon_audit ON wagon;
            CREATE TRIGGER trg_wagon_audit
            AFTER INSERT OR UPDATE OR DELETE ON wagon
            FOR EACH ROW EXECUTE FUNCTION public.wagon_audit_trigger_fn();
            ]]>
        </sql>

